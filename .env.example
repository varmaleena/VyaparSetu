# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini platform configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Optional server features
ADK_WEB=false
OTEL_TO_CLOUD=false
OTEL_CONSOLE=false
ALLOW_ORIGINS=

# Local Compose defaults. Override outside local development.
DATABASE_URL=postgresql+psycopg://vyaparsetu:vyaparsetu@127.0.0.1:5432/vyaparsetu
REDIS_URL=redis://127.0.0.1:6379/0

# Future infrastructure integrations
INVOICE_GCP_PROJECT=work-511514
INVOICE_GEMINI_MODEL=gemini-3.5-flash-lite
INVOICE_GEMINI_LOCATION=global
INVOICE_BUCKET=work-511514-vyaparsetu-invoices
# Set a private random token to enable the single-merchant demo API.
INVOICE_DEMO_TOKEN=
INVOICE_DEMO_MERCHANT_ID=demo-merchant-00
SARVAM_API_KEY=
